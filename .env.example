# Environment Configuration Template (100% Free Open Source Stack)
PROJECT_NAME="Plant Disease Detection System"
ENVIRONMENT="development"
DEBUG=True

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000

# Database Configuration (PostgreSQL 16 - Local Docker / Free Tier Cloud)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_2026
POSTGRES_DB=plant_disease_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_2026@db:5432/plant_disease_db

# Redis Cache Configuration (Redis 7 - Local Docker / Free Tier Cloud)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security Secrets (Generate custom keys for production)
SECRET_KEY="development_secret_key_plant_disease_detection_2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
